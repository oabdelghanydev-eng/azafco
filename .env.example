# Sample Environment Variables
# Copy this file to .env.local and fill in the values

# Google Analytics Measurement ID
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Optional: API URL (if needed in future)
# NEXT_PUBLIC_API_URL=https://api.azafco.com.eg

# ─── Partnership / quote form (app/api/contact/route.ts) ───────────────────
# Enquiries from /[locale]/contact#partnership are emailed through Resend (https://resend.com).
# If any of these is missing, the form shows an error with the company email/WhatsApp
# and the enquiry is written to the server log (Vercel → Logs) instead of being emailed.
# Set all three in Vercel → Project → Settings → Environment Variables (Production + Preview).

# Resend API key (Resend dashboard → API Keys; "Sending access" is enough). Server-only: never prefix with NEXT_PUBLIC_.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Who receives enquiries. Comma-separate several addresses.
CONTACT_TO_EMAIL=business@azafco.com.eg

# Sender. Must be on a domain verified in Resend (Resend → Domains → add azafco.com.eg + DNS records).
# The buyer's address is set as Reply-To, so "Reply" in your mail client answers the buyer.
CONTACT_FROM_EMAIL="AZAFCO Website <website@azafco.com.eg>"
